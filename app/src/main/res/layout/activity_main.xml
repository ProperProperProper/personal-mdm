<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/ownerStatus"
                android:textStyle="bold"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Policies"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swEnforce"
                android:text="Enforce app whitelist (suspend everything else)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swGate"
                android:text="Gate new apps (quarantine + approve/deny)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockInstalls"
                android:text="Block all app installs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockUninstalls"
                android:text="Block uninstall of whitelisted apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockUnknown"
                android:text="Block sideloading (unknown sources)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swKiosk"
                android:text="Kiosk home screen (whitelisted apps fill screen)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDns"
                android:text="Force secure DNS (DNS-over-TLS, device-wide)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/dnsHost"
                android:hint="DoT hostname, e.g. dns.quad9.net or one.one.one.one"
                android:inputType="textUri|textNoSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swCookies"
                android:text="Chrome: block all cookies except allowlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/cookieSites"
                android:hint="Cookie allowlist, one pattern per line e.g. [*.]lastpass.com"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/saveCookies"
                android:text="Save cookie allowlist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAutoclear"
                android:text="Chrome: auto-clear browsing data on exit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSafeboot"
                android:text="Disable Safe Mode boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swPassword"
                android:text="Password hardening (strong lock enforced)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swNoCapture"
                android:text="Disable screenshots and screen recording"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDisableNfc"
                android:text="Disable NFC entirely (also stops tap-to-pay)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="NFC is all-or-nothing: Android can't limit it to payment terminals (payment and tag-reading share one radio). Left ON, malicious-tag URLs are already defanged by Link Guard."
                android:textSize="11sp"
                android:textStyle="italic"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAppScreenshotGuard"
                android:text="Protect this MDM screen from screenshots/casting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockMirroring"
                android:text="Block all sharing/casting to other devices (Smart View, Quick Share, DLNA, beam) — adb to Mac unaffected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swWifiLock"
                android:text="Lock Wi-Fi to allowed networks only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/wifiSsids"
                android:hint="Allowed SSIDs, one per line"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/saveWifi"
                android:text="Save allowed Wi-Fi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockTethering"
                android:text="Block tethering/hotspot (BT/USB/Ethernet) — adb dev unaffected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBluetoothLock"
                android:text="Lock Bluetooth (no new pairings; keep JBL TUNE BEAM)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSettingsLockdown"
                android:text="Lock Settings (factory reset, users, app force-stop)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="When a policy above is ON, its matching control in the device Settings app is greyed out too — so nothing can be undone there by accident."
                android:textSize="11sp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMic"
                android:text="Microphone: phone calls only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swTimeLimits"
                android:text="Session time limit (auto-close after N minutes open)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/sessionLimit"
                android:hint="Minutes an app may stay open, e.g. 120"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Exempt (never limited): Clock/alarm, Phone, Messages. 30-min cooldown before a closed app can reopen."
                android:textSize="11sp"
                android:paddingBottom="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/saveTimeLimits"
                android:text="Save session limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swBlockUserCa"
                android:text="Block user-added CA certificates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/scanCerts"
                android:text="Scan for cert-sensitive apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/certScanResult"
                android:textSize="11sp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Audit log"
                android:paddingTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/clearAudit"
                android:text="Clear audit log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/auditView"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/pendingHeader"
                android:paddingTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swHttpsOnly"
                android:text="HTTPS only (block http, ftp, sftp, file, etc.)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swLinkGuard"
                android:text="Link Guard (tapped links show URL, never open)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swDownloads"
                android:text="Block downloads and file saving (browser + apps)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swFirewall"
                android:text="Per-app internet firewall (sinkhole VPN)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Internet access per app"
                android:paddingTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/netList"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="App whitelist"
                android:paddingTop="16dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appList"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
